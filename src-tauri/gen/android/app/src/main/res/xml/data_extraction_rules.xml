<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing of lines goes to a cloud backup or to a new device. Its web view's
     storage holds the notes and, without the app lock, sync's keys in plain text; notes come back
     through sync instead (docs/limitations.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
